{
  "name": "@sldmn233/dsh-profile-sync",
  "version": "0.1.0",
  "type": "module",
  "description": "Exports selected DSH plugins as one pasteable share code, applies the delta on another machine, and reports which credentials still need configuring.",
  "license": "MIT",
  "author": "sldmn233",
  "homepage": "https://github.com/sldmn233/dsh-profile-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sldmn233/dsh-profile-sync.git"
  },
  "bugs": {
    "url": "https://github.com/sldmn233/dsh-profile-sync/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-manager",
    "profile",
    "share",
    "sync",
    "backup"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/local-smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
